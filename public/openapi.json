{
  "openapi": "3.1.0",
  "info": {
    "title": "SMART CASSAVAS — Public documentation API",
    "version": "1.0.0",
    "description": "Read-only public documentation. Resident, payment and management APIs require separate authorization and are outside this specification. MCP JSON-RPC is documented at /docs. The JSON guide API is versioned in the path. Breaking changes use a new major path. Scheduled retirement is announced in /docs and through the Sunset header. Response schemas describe actual media types: HTML, Markdown, plain text and XML stay textual. Only public JSON operations expose strict JSON objects. The CLI is source-distributed and is not published on npm."
  },
  "servers": [
    {
      "url": "https://quanly-toanha-dancu.vercel.app"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "SMART CASSAVAS homepage",
        "operationId": "readHomepage",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Page"
          },
          "406": {
            "description": "Neither HTML nor Markdown is acceptable.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "SMART CASSAVAS homepage. Read-only public resource; does not authorize business actions.",
        "parameters": []
      }
    },
    "/{page}": {
      "get": {
        "summary": "Read a public SMART CASSAVAS guide",
        "operationId": "readGuide",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "description": "Public guide slug.",
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "about",
                "contact",
                "privacy",
                "docs",
                "mcp",
                "cli"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Page"
          },
          "406": {
            "description": "Neither HTML nor Markdown is acceptable.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Read a public SMART CASSAVAS guide. Read-only public resource; does not authorize business actions."
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "readAgentInstructions",
        "responses": {
          "200": {
            "description": "Agent guidance and documentation links",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Read instructions for AI agents",
        "description": "Read instructions for AI agents. Read-only public resource; does not authorize business actions.",
        "parameters": []
      }
    },
    "/sitemap.xml": {
      "get": {
        "operationId": "readSitemap",
        "responses": {
          "200": {
            "description": "Indexable public URLs",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "List indexable public pages",
        "description": "List indexable public pages. Read-only public resource; does not authorize business actions.",
        "parameters": []
      }
    },
    "/api/v1/public/guides/{page}": {
      "get": {
        "summary": "Read a SMART CASSAVAS public guide as JSON",
        "description": "Returns public Markdown for the requested guide. No credentials are required.",
        "operationId": "readPublicGuideJson",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "description": "Public guide slug.",
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "about",
                "contact",
                "privacy",
                "docs",
                "mcp",
                "cli"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public guide as JSON.",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guide"
                }
              }
            }
          },
          "404": {
            "description": "Unknown public guide.",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/PublicCacheUnavailable"
          }
        }
      }
    },
    "/.well-known/mcp": {
      "get": {
        "summary": "Read SMART CASSAVAS MCP discovery",
        "description": "Read site-specific MCP discovery metadata. This is not registration or certification by an MCP registry.",
        "operationId": "readMcpDiscovery",
        "responses": {
          "200": {
            "description": "Public MCP discovery metadata.",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpDiscovery"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/PublicCacheUnavailable"
          }
        },
        "parameters": []
      }
    },
    "/api/v1/public/cli": {
      "get": {
        "summary": "Read SMART CASSAVAS CLI metadata",
        "description": "Read source installation instructions, commands and allowed guide slugs. No account or database health information is returned.",
        "operationId": "readCliInfo",
        "responses": {
          "200": {
            "description": "Public CLI information.",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimit-Reset"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CliToolInfo"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/PublicCacheUnavailable"
          }
        },
        "parameters": []
      }
    }
  },
  "components": {
    "responses": {
      "Page": {
        "description": "Public page selected using Accept quality values; HTML is the default",
        "headers": {
          "Vary": {
            "schema": {
              "type": "string",
              "const": "Accept"
            }
          }
        },
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          },
          "text/markdown": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Public request quota exceeded; do not automatically retry before Retry-After.",
        "headers": {
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimit-Policy"
          },
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimit-Limit"
          },
          "RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimit-Remaining"
          },
          "RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimit-Reset"
          },
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/X-RateLimit-Limit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/X-RateLimit-Remaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/X-RateLimit-Reset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PublicCacheUnavailable": {
        "description": "Rate-limit storage unavailable; the server does not bypass enforcement.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Guide": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string",
            "enum": [
              "home",
              "about",
              "contact",
              "privacy",
              "docs",
              "mcp",
              "cli"
            ],
            "description": "Public guide slug."
          },
          "title": {
            "type": "string",
            "description": "Product and guide title."
          },
          "markdown": {
            "type": "string",
            "description": "Read-only public Markdown."
          },
          "updated_at": {
            "type": "string",
            "format": "date",
            "description": "Public documentation revision date."
          }
        },
        "required": [
          "page",
          "title",
          "markdown",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "guide_not_found",
              "rate_limit_exceeded",
              "public_cache_unavailable"
            ],
            "description": "Stable public error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable public error message."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "McpDiscovery": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Public MCP service name."
          },
          "description": {
            "type": "string",
            "description": "Scope and discovery limitations."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "MCP Streamable HTTP URL."
          },
          "transport": {
            "type": "string",
            "enum": [
              "streamable-http"
            ],
            "description": "Supported transport."
          },
          "protocolVersions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Supported MCP protocol versions."
          },
          "documentation": {
            "type": "string",
            "format": "uri",
            "description": "Official documentation URL."
          },
          "authentication": {
            "type": "string",
            "description": "Public documentation only; no credentials."
          }
        },
        "required": [
          "name",
          "description",
          "url",
          "transport",
          "protocolVersions",
          "documentation",
          "authentication"
        ],
        "additionalProperties": false
      },
      "CliToolInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "CLI display name."
          },
          "command": {
            "type": "string",
            "description": "Source-distributed command name."
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Bundled CLI version."
          },
          "description": {
            "type": "string",
            "description": "Read-only scope."
          },
          "installation": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "format": "uri",
                "description": "Official source repository."
              },
              "local": {
                "type": "string",
                "description": "Command to run from a clone with Node.js."
              },
              "npm": {
                "type": "null",
                "description": "No npm package has been published."
              },
              "npx": {
                "type": "null",
                "description": "No npm registry executable is advertised."
              }
            },
            "required": [
              "repository",
              "local",
              "npm",
              "npx"
            ],
            "additionalProperties": false
          },
          "commands": {
            "type": "array",
            "description": "Supported public commands.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Command name."
                },
                "description": {
                  "type": "string",
                  "description": "Read-only operation description."
                },
                "usage": {
                  "type": "string",
                  "description": "Command usage."
                }
              },
              "required": [
                "name",
                "description",
                "usage"
              ],
              "additionalProperties": false
            }
          },
          "pages": {
            "type": "array",
            "description": "Allowed public guide slugs.",
            "items": {
              "type": "string",
              "enum": [
                "home",
                "about",
                "contact",
                "privacy",
                "docs",
                "mcp",
                "cli"
              ]
            }
          }
        },
        "required": [
          "name",
          "command",
          "version",
          "description",
          "installation",
          "commands",
          "pages"
        ],
        "additionalProperties": false
      }
    },
    "headers": {
      "RateLimit-Policy": {
        "description": "Structured fields per IETF draft-ietf-httpapi-ratelimit-headers-11; quota applies to the configured shared store or local instance.",
        "schema": {
          "type": "string"
        }
      },
      "RateLimit": {
        "description": "Structured fields per IETF draft-ietf-httpapi-ratelimit-headers-11; quota applies to the configured shared store or local instance.",
        "schema": {
          "type": "string"
        }
      },
      "RateLimit-Limit": {
        "description": "Compatibility header. Reset is seconds except X-RateLimit-Reset, which is a Unix timestamp.",
        "schema": {
          "type": "string"
        }
      },
      "RateLimit-Remaining": {
        "description": "Compatibility header. Reset is seconds except X-RateLimit-Reset, which is a Unix timestamp.",
        "schema": {
          "type": "string"
        }
      },
      "RateLimit-Reset": {
        "description": "Compatibility header. Reset is seconds except X-RateLimit-Reset, which is a Unix timestamp.",
        "schema": {
          "type": "string"
        }
      },
      "X-RateLimit-Limit": {
        "description": "Compatibility header. Reset is seconds except X-RateLimit-Reset, which is a Unix timestamp.",
        "schema": {
          "type": "string"
        }
      },
      "X-RateLimit-Remaining": {
        "description": "Compatibility header. Reset is seconds except X-RateLimit-Reset, which is a Unix timestamp.",
        "schema": {
          "type": "string"
        }
      },
      "X-RateLimit-Reset": {
        "description": "Compatibility header. Reset is seconds except X-RateLimit-Reset, which is a Unix timestamp.",
        "schema": {
          "type": "string"
        }
      },
      "Retry-After": {
        "description": "Seconds before attempting again.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
