# FastAPI & SQL Server Environment Configuration Example
# Copy this file to backend/.env and update values for your local environment

PROJECT_NAME="Smart Apartment Management - Amenity System"
API_V1_STR=/api/v1

# Microsoft SQL Server Database Configuration
DB_DRIVER="ODBC Driver 17 for SQL Server"
DB_SERVER="localhost\\SQLEXPRESS"
DB_PORT=1433
DB_DATABASE="CSDL_CHUNGCU&DANCU"
DB_USERNAME=""
DB_PASSWORD=""
DB_TRUSTED_CONNECTION="yes"
DB_TRUST_SERVER_CERTIFICATE="yes"

# JWT Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Seed Password (used only if database users do not exist)
ADMIN_DEFAULT_PASSWORD="YourSecurePasswordHere@2026"
