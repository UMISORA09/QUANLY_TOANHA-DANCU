APP_NAME="Smart Cassavas"
APP_ENV=production
APP_KEY=base64:GENERATE_A_REAL_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://your-domain.example
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database MySQL Production
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=quanly_toanha
DB_USERNAME=smart_app
DB_PASSWORD=CHANGE_THIS_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_OTHER_LONG_RANDOM_PASSWORD

# Redis Cache, Session & Queue
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_LONG_RANDOM_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=smart_cassavas_

# Laravel Drivers
CACHE_STORE=redis
CACHE_PREFIX=smart_cassavas_cache_
SESSION_DRIVER=redis
SESSION_STORE=cache
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
RUN_MIGRATIONS=false
